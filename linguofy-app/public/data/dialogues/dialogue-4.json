    ],
    "dialogue": [
        {
            "speaker": "agent",
            "text": "Buenos días. Su pasaporte, por favor.",
            "translation": "Good morning. Your passport, please."
        },
        {
            "speaker": "you",
            "text": "Buenos días. Aquí tiene.",
            "translation": "Good morning. Here it is."
        },
        {
            "speaker": "agent",
            "text": "¿Tiene equipaje para facturar?",
            "translation": "Do you have luggage to check in?"
        },
        {
            "speaker": "you",
            "text": "Solo una maleta. Llevo esto en la cabina.",
            "translation": "Just one suitcase. I'm taking this in the cabin."
        },
        {
            "speaker": "agent",
            "text": "Perfecto. Su puerta de embarque es la B12. ¡Buen vuelo!",
            "translation": "Perfect. Your boarding gate is B12. Have a good flight!"
        },
        {
            "speaker": "you",
            "text": "Muchas gracias. Adiós.",
            "translation": "Thank you very much. Goodbye."
        }
    ],
    "focusVocab": [
        "pasaporte",
        "equipaje",
        "maleta",
        "puerta de embarque",
        "vuelo"
    ],
