        "tostada",
        "por favor",
        "gracias",
        "euros"
    ],
    "exercises": [
        {
            "id": "ex1",
            "type": "multiple_choice",
            "question": "How do you say 'I want a coffee' in Spanish?",
            "question_fr": "Comment dit-on 'Je veux un café' en espagnol ?",
            "options": [
                "Tengo un café",
                "Quiero un café",
                "Hay un café"
            ],
            "options_fr": [
                "Tengo un café",
                "Quiero un café",
                "Hay un café"
            ],
            "correct": "Quiero un café",
            "hint": "💡 quiero = I want",
            "hint_fr": "💡 quiero = je veux"
        },
        {
            "id": "ex2",
            "type": "fill_blank",
            "question": "Un café con _____, por favor. (A coffee with milk)",
            "question_fr": "Un café con _____, por favor. (Un café au lait)",
            "options": [
                "agua",
                "leche",
                "azúcar"
            ],
            "options_fr": [
                "agua (eau)",
                "leche (lait)",
                "azúcar (sucre)"
            ],
            "correct": "leche",
            "hint": "💡 leche = milk",
            "hint_fr": "💡 leche = lait"
        },
        {
            "id": "ex3",
            "type": "translation",
            "question": "Translate: 'Anything else?'",
            "question_fr": "Traduisez : 'Autre chose ?'",
